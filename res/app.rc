1 ICON "app.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "PeriBattery"
      VALUE "FileDescription", "PeriBattery - bateria dos perifericos na barra de tarefas"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "PeriBattery"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "PeriBattery.exe"
      VALUE "ProductName", "PeriBattery"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
